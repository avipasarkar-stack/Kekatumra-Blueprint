# Copy to .env and adjust. All values are optional.
PORT=3000
# 127.0.0.1 = only reachable through a reverse proxy (recommended). Use 0.0.0.0 to listen directly.
HOST=127.0.0.1
DB_PATH=./data/kekatumra.db
NODE_ENV=production
# Set to true ONLY when running behind a reverse proxy (nginx/Caddy) that sets X-Forwarded-For.
TRUST_PROXY=false
# Cookies are Secure (HTTPS-only) in production. Set false only for plain-HTTP local testing.
# COOKIE_SECURE=false
SESSION_HOURS=12
# Max public submissions (suggestions/workers/ratings) per IP per hour, per type.
SUBMIT_LIMIT_PER_HOUR=20
